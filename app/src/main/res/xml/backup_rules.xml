<?xml version="1.0" encoding="utf-8"?>
<!--
    Island backs up the user's configuration and nothing else.

    Because these rules use <include>, everything not listed is excluded automatically — that
    deliberately covers the local event history (files/island_history.json), any export the user
    generated (cache/exports/) and cached artwork. Android never backs up the cache domain, so it
    takes no rule here.
-->
<full-backup-content>
    <!-- Preferences and DataStore keep the island's settings across a device restore. -->
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
</full-backup-content>
