<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Back up preferences so a restored device keeps the user's Island configuration. -->
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
    <!-- Privacy: the local event history and log exports are never backed up. -->
    <exclude domain="file" path="island_history.json" />
    <exclude domain="cache" path="exports/" />
</full-backup-content>
