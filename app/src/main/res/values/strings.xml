    <!-- Onboarding -->
    <string name="onboarding_step_of">Step %1$d of %2$d</string>
    <string name="onboarding_welcome_title">Meet Island.</string>
    <string name="onboarding_welcome_body">A compact, animated surface around your camera cutout that shows what is happening right now — music, timers, calls, charging and the notifications that matter.</string>
    <string name="onboarding_overlay_title">Let Island appear above your apps</string>
    <string name="onboarding_overlay_body">Island needs the “Display over other apps” permission so the pill can float above whatever you are using. You stay in control: nothing is drawn until you enable Island, and you can revoke this at any time in system settings.</string>
    <string name="onboarding_notifications_title">React to notifications</string>
    <string name="onboarding_notifications_body">With notification access, Island can surface new notifications, group messages from the same app and read media playback. Everything is processed on your device — nothing is uploaded, and you can pick exactly which apps are allowed.</string>
    <string name="onboarding_media_title">Music, timers and device events</string>
    <string name="onboarding_media_body">Island reads the standard Android media session for playback, and can show timers, charging, Bluetooth audio and call state. Each of these has its own switch in settings and works independently of the others.</string>
    <string name="onboarding_test_title">Try it now</string>
    <string name="onboarding_test_body">Send a demo event to the island. Nothing leaves your phone — this is the same pipeline real events use.</string>
    <string name="onboarding_done_title">Island is ready.</string>
    <string name="onboarding_done_body">Your events will appear around the camera cutout. Tune the look, the position and what gets shown in settings.</string>

