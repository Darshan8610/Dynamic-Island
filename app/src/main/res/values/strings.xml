    <!-- Permission explanations & recovery -->
    <string name="permission_overlay_title">Display over other apps</string>
    <string name="permission_overlay_body">Island draws a small pill near your camera cutout. Android requires the “Display over other apps” permission for any window above other applications.</string>
    <string name="permission_listener_title">Notification access</string>
    <string name="permission_listener_body">Notification access lets Island see when a notification arrives, update or is dismissed. Content stays on your device and you choose which apps are monitored.</string>
    <string name="permission_listener_how">In the screen that opens, find “Island notification access” and switch it on. Android may warn that the app can read notifications — that is exactly what this permission is for, and Island never stores content unless you enable history.</string>
    <string name="permission_post_notifications_title">Island notifications</string>
    <string name="permission_post_notifications_body">Used for timer completion and to tell you when Island stops working (for example after a permission is revoked).</string>
    <string name="permission_bluetooth_title">Nearby devices</string>
    <string name="permission_bluetooth_body">Lets Island name the headphones, watch or speaker that just connected. Island never scans for devices.</string>
    <string name="permission_phone_title">Phone state</string>
    <string name="permission_phone_body">Lets Island show an incoming or ongoing call with mute and end controls. Island never reads your call log, never records audio and never intercepts a call.</string>
    <string name="permission_exact_alarm_title">Alarms &amp; reminders</string>
    <string name="permission_exact_alarm_body">Lets a timer finish on time while the screen is off. Without it, Island falls back to an inexact alarm.</string>
    <string name="permission_battery_title">Battery optimization</string>
    <string name="permission_battery_body">Some phones aggressively stop background apps. If Island disappears after a while, allow it to run without restriction.</string>
    <string name="permission_recovery_title">Island is partially disabled</string>
    <string name="permission_recovery_overlay">Display-over-apps permission was revoked. Island cannot draw the pill.</string>
    <string name="permission_recovery_listener">Notification access was revoked. Notifications and media events are paused; timers and device events still work.</string>
    <string name="permission_recovery_notifications">Island cannot post its own notifications (timers will still show in the island).</string>
    <string name="permission_recovery_open">Open Island</string>

